# 数据库配置
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=news_app
DB_ECHO=false

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 新闻采集API（示例）
NEWS_API_URL=
NEWS_API_KEY=
NEWS_API_PLATFORM=weibo
NEWS_API_AUTH_MODE=bearer
NEWS_API_LIMIT_PARAM=limit
NEWS_API_EXTRA_PARAMS=
NEWS_API_TIMEOUT=10

# 阿里云 showapi 示例（按需替换上面配置）
# NEWS_API_URL=https://ali-news.showapi.com/newsList
# NEWS_API_AUTH_MODE=appcode
# NEWS_API_LIMIT_PARAM=maxResult
